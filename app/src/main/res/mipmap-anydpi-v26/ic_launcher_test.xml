<?xml version="1.0" encoding="utf-8"?>
<!-- Same mark as the release icon on a different ground, used only by builds
     made with -PtestBuild. A tester running a debug build beside the release
     has to be able to tell at a glance which one they just opened. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
	<background android:drawable="@color/ic_launcher_test_background" />
	<foreground android:drawable="@drawable/ic_launcher_foreground" />
	<monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
